{
  "name": "mikrobus-rust-tools",
  "displayName": "MikroBUS Embedded Tools",
  "description": "Embedded Rust and C development for mikroBUS hardware in VS Code: configure MCU/board setups, manage toolchains and packages, build, flash and debug across multiple MCU families.",
  "version": "0.8.0",
  "publisher": "IvanRuzavin",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "extensionDependencies": [
    "marus25.cortex-debug",
    "ms-vscode.cpptools",
    "RenesasElectronicsCorporation.renesas-debug"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:mikrobusRust.setupView",
    "onCommand:mikrobusRust.openSetup",
    "onCommand:mikrobusRust.openEnvironmentSetup",
    "onCommand:mikrobusRust.configureMcu",
    "onWebviewPanel:mikrobusRust.mcuConfigurator",
    "onCommand:mikrobusRust.useSetupWithWorkspace",
    "onCommand:mikrobusRust.useCurrentRustFile",
    "onCommand:mikrobusRust.buildWorkspace",
    "onCommand:mikrobusRust.flashWorkspace",
    "onCommand:mikrobusRust.buildFlashWorkspace",
    "onCommand:mikrobusRust.eraseWorkspaceMcu",
    "onCommand:mikrobusRust.buildCurrentFile",
    "onCommand:mikrobusRust.flashCurrentFile",
    "onCommand:mikrobusRust.debugCurrentFile",
    "onCommand:mikrobusC.createSetup",
    "onCommand:mikrobusC.buildSetup",
    "onCommand:mikrobusC.applySetup",
    "onCommand:mikrobusC.build",
    "onCommand:mikrobusC.clean",
    "onCommand:mikrobusC.flash",
    "onCommand:mikrobusC.debug",
    "onCommand:mikrobusC.erase",
    "onCommand:mikrobusC.openInstalledPackages",
    "onCommand:mikrobusC.openCompilerPackages",
    "onDebug:mikrobus-rust-debug",
    "onCommand:mikrobusC.openClickExamples",
    "onCommand:mikrobusC.openDemoExamples",
    "onCommand:mikrobusC.installEnvironment",
    "onWebviewPanel:mikrobusC.hardwareConfigurator"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mikrobusRust.openSetup",
        "title": "MikroBUS Rust: Open Configured Setups"
      },
      {
        "command": "mikrobusRust.openEnvironmentSetup",
        "title": "MikroBUS Rust: Development Environment",
        "icon": "$(tools)"
      },
      {
        "command": "mikrobusRust.configureMcu",
        "title": "MikroBUS Rust: Configure MCU or Board",
        "icon": "$(circuit-board)"
      },
      {
        "command": "mikrobusRust.useSetupWithWorkspace",
        "title": "MikroBUS Rust: Apply Setup to Current Workspace"
      },
      {
        "command": "mikrobusRust.useCurrentRustFile",
        "title": "MikroBUS Rust: Use Current Rust File as main.rs"
      },
      {
        "command": "mikrobusRust.buildWorkspace",
        "title": "MikroBUS Rust: Build Current Project"
      },
      {
        "command": "mikrobusRust.flashWorkspace",
        "title": "MikroBUS Rust: Flash Current Project"
      },
      {
        "command": "mikrobusRust.buildFlashWorkspace",
        "title": "MikroBUS Rust: Build & Flash Current Rust File"
      },
      {
        "command": "mikrobusRust.eraseWorkspaceMcu",
        "title": "MikroBUS Rust: Erase Configured MCU",
        "icon": {
          "light": "media/eraser-light.svg",
          "dark": "media/eraser-dark.svg"
        }
      },
      {
        "command": "mikrobusRust.buildCurrentFile",
        "title": "MikroBUS Rust: Build Current Rust File",
        "icon": {
          "light": "media/hammer-light.svg",
          "dark": "media/hammer-dark.svg"
        }
      },
      {
        "command": "mikrobusRust.flashCurrentFile",
        "title": "MikroBUS Rust: Build & Flash Current Rust File",
        "icon": {
          "light": "media/lightning-light.svg",
          "dark": "media/lightning-dark.svg"
        }
      },
      {
        "command": "mikrobusRust.debugCurrentFile",
        "title": "MikroBUS Rust: Debug Current Rust File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "mikrobusC.createSetup",
        "title": "MikroBUS C: Create and Build Setup",
        "icon": "$(add)"
      },
      {
        "command": "mikrobusC.buildSetup",
        "title": "MikroBUS C: Rebuild Workspace Setup"
      },
      {
        "command": "mikrobusC.applySetup",
        "title": "MikroBUS C: Apply Setup to Workspace"
      },
      {
        "command": "mikrobusC.build",
        "title": "MikroBUS C: Build Project",
        "icon": {
          "light": "media/hammer-light.svg",
          "dark": "media/hammer-dark.svg"
        }
      },
      {
        "command": "mikrobusC.clean",
        "title": "MikroBUS C: Clean Project"
      },
      {
        "command": "mikrobusC.flash",
        "title": "MikroBUS C: Build and Flash Project",
        "icon": {
          "light": "media/lightning-light.svg",
          "dark": "media/lightning-dark.svg"
        }
      },
      {
        "command": "mikrobusC.debug",
        "title": "MikroBUS C: Build and Debug Project",
        "icon": "$(debug-alt)"
      },
      {
        "command": "mikrobusC.erase",
        "title": "MikroBUS C: Erase MCU",
        "icon": {
          "light": "media/eraser-light.svg",
          "dark": "media/eraser-dark.svg"
        }
      },
      {
        "command": "mikrobusC.configureRfpConnection",
        "title": "MikroBUS C: Configure RFP Connection"
      },
      {
        "command": "mikrobusC.openInstalledPackages",
        "title": "MikroBUS C: Installed Packages"
      },
      {
        "command": "mikrobusC.openCompilerPackages",
        "title": "MikroBUS C: Compiler Packages"
      },
      {
        "command": "mikrobusC.installEnvironment",
        "title": "MikroBUS C: Development Environment",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mikrobusC.openClickExamples",
        "title": "MikroBUS C: Click Board Examples",
        "icon": "$(library)"
      },
      {
        "command": "mikrobusC.openDemoExamples",
        "title": "MikroBUS C: Demo Examples",
        "icon": "$(beaker)"
      },
      {
        "command": "mikrobusC.debugUnavailableMikrocCodegrip",
        "title": "Debug is not available in VS Code for mikroC + CODEGRIP \u2014 use NECTO Studio",
        "icon": "$(debug-alt)",
        "enablement": "false"
      },
      {
        "command": "mikrobusC.debugUnavailableRenesasE2",
        "title": "Debug is supported only with Renesas E2 and E2 Lite",
        "icon": "$(debug-alt)",
        "enablement": "false"
      }
    ],
    "configuration": {
      "title": "MikroBUS Embedded",
      "properties": {
        "mikrobusRust.storageRoot": {
          "type": "string",
          "default": "",
          "description": "Root directory shared by Rust and C extension-managed SDKs, databases, tools, packages and setups. Use Change in either Development Environment to migrate all managed content to a new folder."
        },
        "mikrobusRust.cargoPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to cargo. Leave empty to resolve cargo from PATH, CARGO_HOME/bin or ~/.cargo/bin."
        },
        "mikrobusRust.rustupPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to rustup. Leave empty to resolve rustup from PATH, CARGO_HOME/bin or ~/.cargo/bin."
        },
        "mikrobusRust.probeRsPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to probe-rs. Leave empty to resolve it from PATH, CARGO_HOME/bin or ~/.cargo/bin."
        },
        "mikrobusRust.codegripServerPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to CodegripGdbServer or its bin directory. Leave empty to use the extension-managed CODEGRIP package first, then PATH or the standard NECTOStudio7 CODEGRIP package."
        },
        "mikrobusRust.codegripPacksPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the CODEGRIP packs directory. Leave empty to use packs from the resolved extension-managed, PATH, or NECTO CODEGRIP package."
        },
        "mikrobusRust.codegripEraseCommand": {
          "type": "string",
          "default": "erase",
          "description": "CODEGRIP control command used for standalone erase. NECTO uses erase; override only for compatibility with a different server build."
        },
        "mikrobusRust.armGccBinPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an ARM GCC bin directory. A path to one tool in that directory is also accepted and sibling tools are resolved beside it. Leave empty to use PATH or the ARM GCC package already managed by Development Environment."
        },
        "mikrobusRust.cDatabasePath": {
          "type": "string",
          "default": "",
          "description": "Path to a NECTO-compatible necto_db.db SQLite database used by C setup selection. Leave empty to use the managed database or the standard NECTOStudio7 path."
        },
        "mikrobusRust.cCmakePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the CMake executable or a directory containing it for C core, SDK and project builds. Leave empty to use PATH/common host locations or the extension-managed CMake package."
        },
        "mikrobusRust.cNinjaPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the Ninja executable or a directory containing it for C core, SDK and project builds. Leave empty to use PATH/common host locations or the extension-managed Ninja package."
        },
        "mikrobusRust.jlinkCommanderPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to JLinkExe/JLink.exe or the SEGGER J-Link directory. Leave empty to use PATH, the NECTO SEGGER programmer package, or standard SEGGER install locations."
        },
        "mikrobusRust.jlinkGdbServerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to JLinkGDBServerCLExe/JLinkGDBServerCL or the SEGGER J-Link directory. Leave empty to use PATH, the NECTO SEGGER programmer package, or standard SEGGER install locations."
        },
        "mikrobusRust.windowsDebugTransport": {
          "type": "string",
          "enum": [
            "tcp",
            "stdio"
          ],
          "enumDescriptions": [
            "Start a standalone probe-rs DAP TCP server. This is the tested Windows default.",
            "Launch probe-rs as a stdin/stdout child adapter. Use only for diagnostics."
          ],
          "default": "tcp",
          "description": "probe-rs DAP transport used on Windows."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mikrobusRust",
          "title": "MikroBUS Embedded",
          "icon": "media/mikrobus-module-3d-transparent.png"
        }
      ]
    },
    "views": {
      "mikrobusRust": [
        {
          "type": "webview",
          "id": "mikrobusRust.setupView",
          "name": "Environment"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "mikrobusRust.buildCurrentFile",
          "when": "editorLangId == rust && mikrobusRust.workspaceBound",
          "group": "navigation@10"
        },
        {
          "command": "mikrobusRust.flashCurrentFile",
          "when": "editorLangId == rust && mikrobusRust.workspaceBound",
          "group": "navigation@11"
        },
        {
          "command": "mikrobusRust.debugCurrentFile",
          "when": "editorLangId == rust && mikrobusRust.workspaceBound",
          "group": "navigation@12"
        },
        {
          "command": "mikrobusRust.eraseWorkspaceMcu",
          "when": "editorLangId == rust && mikrobusRust.workspaceBound",
          "group": "navigation@13"
        },
        {
          "command": "mikrobusC.build",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cProjectReady && (editorLangId == c || editorLangId == cpp)",
          "group": "navigation@20"
        },
        {
          "command": "mikrobusC.flash",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cProjectReady && (editorLangId == c || editorLangId == cpp)",
          "group": "navigation@21"
        },
        {
          "command": "mikrobusC.debug",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cProjectReady && (editorLangId == c || editorLangId == cpp) && mikrobusRust.cDebugAvailable",
          "group": "navigation@22"
        },
        {
          "command": "mikrobusC.debugUnavailableMikrocCodegrip",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cProjectReady && (editorLangId == c || editorLangId == cpp) && mikrobusRust.cDebugUnavailableMikrocCodegrip",
          "group": "navigation@22"
        },
        {
          "command": "mikrobusC.debugUnavailableRenesasE2",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cProjectReady && (editorLangId == c || editorLangId == cpp) && mikrobusRust.cDebugUnavailableRenesasE2Required",
          "group": "navigation@22"
        },
        {
          "command": "mikrobusC.erase",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cProjectReady && (editorLangId == c || editorLangId == cpp)",
          "group": "navigation@23"
        }
      ],
      "commandPalette": [
        {
          "command": "mikrobusC.createSetup",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.buildSetup",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.applySetup",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.build",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.clean",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.flash",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.debug",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cDebugAvailable"
        },
        {
          "command": "mikrobusC.erase",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.openInstalledPackages",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.installEnvironment",
          "when": "mikrobusRust.cSupportEnabled"
        },
        {
          "command": "mikrobusC.configureRfpConnection",
          "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cRfpSelected"
        },
        {
          "command": "mikrobusC.debugUnavailableMikrocCodegrip",
          "when": "false"
        },
        {
          "command": "mikrobusC.debugUnavailableRenesasE2",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mikrobusRust.buildCurrentFile",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == rust && mikrobusRust.workspaceBound"
      },
      {
        "command": "mikrobusRust.flashCurrentFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == rust && mikrobusRust.workspaceBound"
      },
      {
        "command": "mikrobusRust.debugCurrentFile",
        "key": "f5",
        "when": "editorLangId == rust && mikrobusRust.workspaceBound"
      },
      {
        "command": "mikrobusC.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cWorkspaceBound && (editorLangId == c || editorLangId == cpp)"
      },
      {
        "command": "mikrobusC.flash",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cWorkspaceBound && (editorLangId == c || editorLangId == cpp)"
      },
      {
        "command": "mikrobusC.debug",
        "key": "f5",
        "when": "mikrobusRust.cSupportEnabled && mikrobusRust.cWorkspaceBound && (editorLangId == c || editorLangId == cpp) && mikrobusRust.cDebugAvailable"
      }
    ],
    "debuggers": [
      {
        "type": "mikrobus-rust-debug",
        "label": "MikroBUS Rust (probe-rs)",
        "languages": [
          "rust"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "chip",
              "coreConfigs"
            ],
            "properties": {
              "chip": {
                "type": "string",
                "description": "probe-rs chip name."
              },
              "cwd": {
                "type": "string",
                "description": "Rust SDK working directory."
              },
              "connectUnderReset": {
                "type": "boolean",
                "default": true
              },
              "wireProtocol": {
                "type": "string",
                "enum": [
                  "Swd",
                  "Jtag"
                ],
                "default": "Swd",
                "description": "Debug wire protocol passed to probe-rs."
              },
              "flashingConfig": {
                "type": "object"
              },
              "coreConfigs": {
                "type": "array"
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check mcu_configurator.js && node --check codegrip_backend.js && node --check c_setup.js && node --check c_compiler_support.js && node --check c_configurator.js && node --check c_database.js && node --check c_package_catalog.js && node --check c_codegrip_catalog.js && node --check c_package_manager.js && node --check feature_flags.js && node --check media/setup.js && node --check media/mcu.js && node --check media/c_mcu.js && node --check media/setups.js && node --check c_rfp_backend.js && node --check c_cmake_visibility.js",
    "test": "node test/c_support.test.js",
    "build": "npx @vscode/vsce package"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0"
  },
  "license": "MIT",
  "icon": "media/mikrobus-module-3d-transparent.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IvanRuzavin/Rusty_MikroBUS.git"
  },
  "homepage": "https://github.com/IvanRuzavin/Rusty_MikroBUS#readme",
  "author": "IvanRuzavin",
  "keywords": [
    "mikrobus",
    "embedded",
    "microcontroller",
    "mcu",
    "rust",
    "c",
    "mikrosdk",
    "codegrip",
    "j-link",
    "probe-rs",
    "debugging",
    "firmware",
    "necto"
  ],
  "bugs": {
    "url": "https://github.com/IvanRuzavin/Rusty_MikroBUS/issues"
  }
}
